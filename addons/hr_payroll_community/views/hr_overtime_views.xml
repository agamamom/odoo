<odoo>
    <record id="view_hr_overtime_list" model="ir.ui.view">
        <field name="name">hr.overtime.list</field>
        <field name="model">hr.overtime</field>
        <field name="arch" type="xml">
            <list string="Đơn làm thêm giờ">
                <field name="name" string="Mã đơn" width="100"/>
                <field name="employee_id" string="Nhân viên" width="180"/>
                <field name="date" string="Ngày" width="110"/>
                <field name="shift_id" string="Ca làm" width="120"/>
                <field name="hours" string="Số giờ" width="80"/>
                <field name="overtime_type" string="Loại làm thêm" width="120"/>
                <field name="state" string="Trạng thái" width="110"/>
                <field name="approver_id" string="Người duyệt" width="150"/>
                <field name="company_id" string="Công ty" width="150"/>
            </list>
        </field>
    </record>

    <record id="view_hr_overtime_form" model="ir.ui.view">
        <field name="name">hr.overtime.form</field>
        <field name="model">hr.overtime</field>
        <field name="arch" type="xml">
            <form string="Đơn làm thêm giờ">
                <sheet>
                    <group>
                        <field name="name" string="Mã đơn"/>
                        <field name="employee_id" string="Nhân viên"/>
                        <field name="date" string="Ngày"/>
                        <field name="shift_id" string="Ca làm"/>
                        <field name="hours" string="Số giờ"/>
                        <field name="overtime_type" string="Loại làm thêm"/>
                        <field name="wage_coefficient" string="Hệ số lương" readonly="1"/>
                        <field name="state" string="Trạng thái"/>
                        <field name="approver_id" string="Người duyệt"/>
                        <field name="approve_date" string="Ngày duyệt"/>
                        <field name="note" string="Ghi chú"/>
                        <field name="company_id" string="Công ty"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_overtime_search" model="ir.ui.view">
        <field name="name">hr.overtime.search</field>
        <field name="model">hr.overtime</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm làm thêm giờ">
                <field name="name" string="Mã đơn"/>
                <field name="employee_id" string="Nhân viên"/>
                <field name="date" string="Ngày"/>
                <field name="overtime_type" string="Loại làm thêm"/>
                <field name="state" string="Trạng thái"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Loại làm thêm" name="group_by_type" context="{'group_by': 'overtime_type'}"/>
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_overtime" model="ir.actions.act_window">
        <field name="name">Đơn làm thêm giờ</field>
        <field name="res_model">hr.overtime</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_hr_overtime_search"/>
    </record>

    <menuitem id="menu_hr_overtime_root" name="Làm thêm giờ" parent="hr_payroll_community.menu_hr_payroll_community_root" sequence="60"/>
    <menuitem id="menu_hr_overtime" name="Đơn làm thêm giờ" parent="menu_hr_overtime_root" action="action_hr_overtime" sequence="10"/>
</odoo> 