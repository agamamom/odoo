<odoo>
    <record id="view_hr_dependent_list" model="ir.ui.view">
        <field name="name">hr.dependent.list</field>
        <field name="model">hr.dependent</field>
        <field name="arch" type="xml">
            <list string="Người phụ thuộc">
                <field name="name" string="Họ tên" width="180"/>
                <field name="employee_id" string="Nhân viên" width="180"/>
                <field name="relation" string="Quan hệ" width="120"/>
                <field name="birthday" string="Ngày sinh" width="110"/>
                <field name="id_number" string="Số CMND/CCCD" width="120"/>
                <field name="start_date" string="Từ ngày" width="110"/>
                <field name="end_date" string="Đến ngày" width="110"/>
                <field name="state" string="Trạng thái" width="110"/>
                <field name="company_id" string="Công ty" width="150"/>
            </list>
        </field>
    </record>

    <record id="view_hr_dependent_form" model="ir.ui.view">
        <field name="name">hr.dependent.form</field>
        <field name="model">hr.dependent</field>
        <field name="arch" type="xml">
            <form string="Người phụ thuộc">
                <sheet>
                    <group>
                        <field name="name" string="Họ tên"/>
                        <field name="employee_id" string="Nhân viên"/>
                        <field name="relation" string="Quan hệ"/>
                        <field name="birthday" string="Ngày sinh"/>
                        <field name="id_number" string="Số CMND/CCCD"/>
                        <field name="start_date" string="Từ ngày"/>
                        <field name="end_date" string="Đến ngày"/>
                        <field name="state" string="Trạng thái"/>
                        <field name="note" string="Ghi chú"/>
                        <field name="company_id" string="Công ty"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_dependent_search" model="ir.ui.view">
        <field name="name">hr.dependent.search</field>
        <field name="model">hr.dependent</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm người phụ thuộc">
                <field name="name" string="Họ tên"/>
                <field name="employee_id" string="Nhân viên"/>
                <field name="relation" string="Quan hệ"/>
                <field name="state" string="Trạng thái"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Quan hệ" name="group_by_relation" context="{'group_by': 'relation'}"/>
                    <filter string="Trạng thái" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_dependent" model="ir.actions.act_window">
        <field name="name">Người phụ thuộc</field>
        <field name="res_model">hr.dependent</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="search_view_id" ref="view_hr_dependent_search"/>
    </record>

    <menuitem id="menu_hr_dependent_root" name="Người phụ thuộc" parent="hr_payroll_community.menu_hr_payroll_community_root" sequence="70"/>
    <menuitem id="menu_hr_dependent" name="Người phụ thuộc" parent="menu_hr_dependent_root" action="action_hr_dependent" sequence="10"/>
</odoo> 