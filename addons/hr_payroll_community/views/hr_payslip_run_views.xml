<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <!-- Search view of payslip runs -->
    <record id="hr_payslip_run_search" model="ir.ui.view">
        <field name="name">hr.payslip.run.search</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm đợt lương">
                <field name="name" string="Đợt lương"/>
                <field name="date_start" string="Từ ngày"/>
                <field name="date_end" string="Đến ngày"/>
                <filter string="Nháp" name="draft"
                        domain="[('state','=','draft')]"
                        help="Đợt lương nháp"/>
                <filter name="done_filter" string="Đã đóng"
                        domain="[('state','=','close')]"
                        help="Đợt lương đã đóng"/>
            </search>
        </field>
    </record>
<!--    List view of hr_payslip_run-->
    <record id="hr_payslip_run_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.list</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <list string="Đợt lương">
                <field name="name" string="Đợt lương" width="200"/>
                <field name="date_start" string="Từ ngày" width="120"/>
                <field name="date_end" string="Đến ngày" width="120"/>
                <field name="credit_note" string="Phiếu ghi có" width="100"/>
                <field name="state" string="Trạng thái" width="120"/>
            </list>
        </field>
    </record>
    <!--    Kanban view of hr_payslip_run-->
    <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
        <field name="name">hr_payslip.run.view.kanban</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div class="row">
                                <div class="col-6">
                                    <strong>
                                        <field name="name" string="Đợt lương"/>
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <span class="float-right badge badge-secondary">
                                        <field name="state" string="Trạng thái"/>
                                    </span>
                                </div>
                                <div class="col-12">
                                    <span>
                                        <field name="date_start" string="Từ ngày"/>
                                        -
                                        <field name="date_end" string="Đến ngày"/>
                                    </span>
                                    <span class="float-right"
                                          title="Phiếu ghi có?">
                                        <field name="credit_note"
                                               widget="boolean" string="Phiếu ghi có"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
<!--   Form view of hr_payslip_run-->
    <record id="hr_payslip_run_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.form</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <form string="Đợt lương">
                <header>
                    <button name="close_payslip_run" type="object"
                            string="Đóng đợt lương" invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="%(hr_payslip_by_employees_action)d"
                            type="action" invisible="state != 'draft'"
                            string="Tạo phiếu lương" class="oe_highlight"/>
                    <button name="action_generate_all_payslips" string="Tạo phiếu lương cho tất cả nhân viên" type="object" class="oe_highlight"/>
                    <button string="Chuyển về nháp" name="action_payslip_run"
                            type="object" invisible="state != 'close'"/>
                    <field name="state" widget="statusbar" string="Trạng thái"/>
                </header>
                <sheet>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" string="Đợt lương" readonly="state != 'draft'"/>
                    </h1>
                    <group col="4">
                        <label for="date_start" string="Kỳ lương"
                               readonly="state != 'draft'"/>
                        <div>
                            <field name="date_start" class="oe_inline" string="Từ ngày"/>
                            -
                            <field name="date_end" class="oe_inline" string="Đến ngày" readonly="state != 'draft'"/>
                        </div>
                        <field name="credit_note" string="Phiếu ghi có" readonly="state != 'draft'"/>
                    </group>
                    <separator string="Phiếu lương"/>
                    <field name="slip_ids" string="Phiếu lương" readonly="state != 'draft'"/>
                </sheet>
            </form>
        </field>
    </record>
<!--    Window action for hr_payslip_run-->
    <record id="hr_payslip_run_action" model="ir.actions.act_window">
        <field name="name">Đợt lương</field>
        <field name="res_model">hr.payslip.run</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hr_payslip_run_search"/>
    </record>
<!--    Menu for hr_payslip-->
    <menuitem action="hr_payslip_run_action" id="menu_hr_payslip_run"
              parent="menu_hr_payroll_community_root"/>
</odoo>
