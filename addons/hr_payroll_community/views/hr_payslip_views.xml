<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- payslip -->
    <record id="hr_payslip_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.view.list</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <list decoration-info="state in ('confirm','hr_check','accont_check')"
                  decoration-muted="state == 'cancel'" string="Danh sách phiếu lương">
                <field name="number" string="Số phiếu" width="100"/>
                <field name="employee_id" string="Nhân viên" width="180"/>
                <field name="name" string="Diễn giải" width="200"/>
                <field name="date_from" string="Từ ngày" width="110"/>
                <field name="date_to" string="Đến ngày" width="110"/>
                <field name="state" string="Trạng thái" width="110"/>
                <field name="company_id" string="Công ty" groups="base.group_multi_company" options="{'no_create': True}" width="150"/>
                <field name="payslip_run_id" string="Đợt lương" invisible="1"/>
            </list>
        </field>
    </record>
    <!-- Payslip kanban view -->
    <record id="hr_payslip_view_kanban" model="ir.ui.view">
        <field name="name">hr.payslip.view.kanban</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div class="row">
                                <div class="col-6">
                                    <strong>
                                        <field name="employee_id" string="Nhân viên"/>
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <span class="float-right badge badge-secondary">
                                        <field name="state" string="Trạng thái"/>
                                    </span>
                                </div>
                                <div class="col-12">
                                    <span>
                                        <field name="date_from" string="Từ ngày"/>
                                        -
                                        <field name="date_to" string="Đến ngày"/>
                                    </span>
                                </div>
                                <div class="col-12">
                                    <span>
                                        <field name="name" string="Diễn giải"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="hr_payslip_search" model="ir.ui.view">
        <field name="name">hr.payslip.select</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm phiếu lương">
                <field name="name" string="Diễn giải"
                       filter_domain="['|',('name','ilike',self),('number','ilike',self)]"/>
                <field name="date_from" string="Từ ngày"/>
                <filter string="Nháp" name="draft"
                        domain="[('state','=','draft')]" help="Phiếu nháp"/>
                <filter string="Đã xác nhận" name="done"
                        domain="[('state','=','done')]" help="Phiếu đã xác nhận"/>
                <field name="employee_id" string="Nhân viên"/>
                <field name="payslip_run_id" string="Đợt lương"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="employee_id"
                            context="{'group_by':'employee_id'}"/>
                    <filter string="Đợt lương" name="payslip_run_id"
                            context="{'group_by':'payslip_run_id'}"/>
                    <filter string="Công ty" name="company_id"
                            groups="base.group_multi_company"
                            context="{'group_by':'company_id'}"/>
                    <filter string="Trạng thái" name="state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="hr_payslip_action" model="ir.actions.act_window">
        <field name="name">Phiếu lương nhân viên</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hr_payslip_search"/>
    </record>
    <menuitem action="hr_payslip_action"
              id="menu_department_tree"
              parent="menu_hr_payroll_community_root"
              groups="hr_payroll_community.group_hr_payroll_community_user"/>
    <record id="action_hr_payslip" model="ir.actions.act_window">
        <field name="res_model">hr.payslip</field>
        <field name="name">Phiếu lương</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_employee_id': [active_id],
            'default_employee_id': active_id}
        </field>
    </record>
    <record id="action_create_payslip_for_employee" model="ir.actions.act_window">
        <field name="name">Tạo phiếu lương mới</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_employee_id': active_id}</field>
    </record>
</odoo>
