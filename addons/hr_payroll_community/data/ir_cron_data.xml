<odoo>
    <record id="ir_cron_auto_generate_payslip_run" model="ir.cron">
        <field name="name">Tự động tạo Payslip Run và phiếu lương</field>
        <field name="model_id" ref="model_hr_payslip_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_generate_payslip_run()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now().replace(day=25, hour=2, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo> 