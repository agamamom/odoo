<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="geolocation_map_widget.GeoLocation" owl="1">
        <div class="o_field_char d-flex flex-column" t-att-class="props.classNames">
            <div class="o_input_map flex-grow-1">
                <input
                        class="o_input"
                        t-att-id="props.id"
                        t-att-name="props.name"
                        t-att-placeholder="props.placeholder"
                        t-att-readonly="props.readonly ? 'readonly' : undefined"
                        t-att-required="props.required ? 'required' : undefined"
                        t-att-maxlength="props.maxLength > 0 and props.maxLength"
                        t-model="input.value"
                        t-on-change="onInputChange"
                        t-on-input="onInput"
                        t-ref="input"
                />
                <div class="map-buttons">
                    <button type="button"
                            class="btn btn-primary btn-sm" id="update_from_address"
                            t-on-click="_updateFromAddressButton">
                        <i class="fa fa-refresh me-1" role="img"/> Cập nhật từ địa chỉ
                    </button>
                    <button type="button"
                            class="btn btn-success btn-sm" id="update_from_coordinates"
                            t-on-click="_updateFromCoordinatesButton">
                        <i class="fa fa-location-arrow me-1" role="img"/> Cập nhật từ tọa độ
                    </button>
                    <button type="button"
                            class="btn o_icon_button" id="open_map"
                            t-on-click="_OpenMapview">
                        <i class="fa fa-map-marker" role="img"
                           aria-label="Open map"
                           title="Open map"/>
                    </button>
                </div>
            </div>
            <div class="input-group mt-2 w-100">
                <!-- Container for the map preview -->
                <div t-ref="mapContainer"
                     class="map-preview o_leaftlet_preview_open"/>
            </div>
        </div>
    </t>
</templates>
