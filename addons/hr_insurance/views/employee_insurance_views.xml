<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List view for insurance -->
    <record id="view_employee_insurance_list" model="ir.ui.view">
        <field name="name">hr.insurance.list</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <list string="Bảo hiểm nhân viên">
                <field name="policy_id" width="220"/>
                <field name="employee_id" width="220"/>
                <field name="policy_coverage" width="150"/>
                <field name="insurance_type" width="150"/>
                <field name="date_from" width="100"/>
                <field name="date_to" width="100"/>
                <field name="amount" sum="Tổng tiền" width="120"/>
                <field name="salary_base" sum="Tổng lương" width="150"/>
                <field name="employee_contribution" sum="Tổng NV" width="150"/>
                <field name="company_contribution" sum="Tổng CT" width="150"/>
                <field name="total_contribution" sum="Tổng cộng" width="150"/>
                <field name="state" width="120"/>
            </list>
        </field>
    </record>

    <!-- Tree View -->
    <record id="hr_insurance_tree_view" model="ir.ui.view">
        <field name="name">hr.insurance.tree</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <list string="Bảo hiểm">
                <field name="name" width="120"/>
                <field name="employee_id" width="220"/>
                <field name="policy_id" width="220"/>
                <field name="insurance_type" width="150"/>
                <field name="insurance_coverage_type" width="180"/>
                <field name="is_voluntary" width="100"/>
                <field name="salary_base" sum="Tổng lương đóng BH" width="180"/>
                <field name="employee_contribution" sum="Tổng NV đóng" width="150"/>
                <field name="company_contribution" sum="Tổng công ty đóng" width="180"/>
                <field name="total_contribution" sum="Tổng cộng" width="150"/>
                <field name="date_from" width="100"/>
                <field name="date_to" width="100"/>
                <field name="state" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-danger="state == 'expired'" width="120"/>
            </list>
        </field>
    </record>

    <!-- Tree View for Employee Form -->
    <record id="hr_insurance_tree_view_for_employee" model="ir.ui.view">
        <field name="name">hr.insurance.tree.for.employee</field>
        <field name="model">hr.insurance</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Bảo hiểm">
                <field name="policy_id" width="220"/>
                <field name="insurance_type" width="150"/>
                <field name="is_social_insurance" invisible="1"/>
                <field name="wage_base" width="120"/>
                <field name="allowances" width="120"/>
                <field name="amount" width="120"/>
                <field name="sum_insured" width="120"/>
                <field name="employee_contribution" readonly="1" width="180"/>
                <field name="company_contribution" readonly="1" width="180"/>
                <field name="policy_coverage" width="180"/>
                <field name="date_from" width="100"/>
                <field name="date_to" readonly="1" width="100"/>
                <field name="state" width="120"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hr_insurance_form_view" model="ir.ui.view">
        <field name="name">hr.insurance.form</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <form string="Bảo hiểm">
                <field name="related_document_model" invisible="1" />
                <field name="related_document_id" invisible="1" />
                <field name="related_partner" invisible="1" />
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_expire" type="object" string="Đánh dấu hết hạn" 
                            invisible="state != 'active'"/>
                    <button name="action_cancel" type="object" string="Hủy" 
                            invisible="state not in ('draft', 'active')"/>
                    <button name="action_draft" type="object" string="Chuyển về dự thảo" 
                            invisible="state not in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar" 
                          statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="policy_id"/>
                            <field name="insurance_type"/>
                            <field name="insurance_coverage_type"/>
                            <field name="is_voluntary"/>
                            <field name="policy_number"/>
                            <field name="social_insurance_code"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="salary_base"/>
                            <field name="employee_contribution"/>
                            <field name="company_contribution"/>
                            <field name="total_contribution"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú" name="notes">
                            <field name="notes" placeholder="Ghi chú về bảo hiểm..."/>
                        </page>
                        <page string="Tài liệu" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Trợ cấp" name="allowances">
                            <field name="allowance_ids" context="{'default_employee_id': employee_id}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter" invisible="1">
                    <field name="message_follower_ids" widget="mail_followers" invisible="1"/>
                    <field name="message_ids" widget="mail_thread" invisible="1"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="hr_insurance_kanban_view" model="ir.ui.view">
        <field name="name">hr.insurance.kanban</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="insurance_type"/>
                <field name="insurance_coverage_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/> - <field name="employee_id"/>
                                </strong>
                                <div>
                                    <span><field name="insurance_type"/></span>
                                    <span t-if="record.insurance_coverage_type.raw_value != 'none'"> 
                                        - <field name="insurance_coverage_type"/>
                                    </span>
                                    <span t-if="record.is_voluntary.raw_value"> (Tự nguyện)</span>
                                </div>
                                <div>
                                    <span>Từ <field name="date_from"/> đến <field name="date_to"/></span>
                                </div>
                                <div>
                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'active': 'success', 'expired': 'danger', 'cancelled': 'warning'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="hr_insurance_search_view" model="ir.ui.view">
        <field name="name">hr.insurance.search</field>
        <field name="model">hr.insurance</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm bảo hiểm">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="policy_id"/>
                <field name="insurance_type"/>
                <field name="insurance_coverage_type"/>
                <field name="social_insurance_code"/>
                <field name="policy_number"/>
                <filter string="Hoạt động" name="active" domain="[('state','=','active')]"/>
                <filter string="Dự thảo" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Hết hạn" name="expired" domain="[('state','=','expired')]"/>
                <filter string="Đã hủy" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="BHXH" name="bhxh" domain="[('insurance_type','=','bhxh')]"/>
                <filter string="BHYT" name="bhyt" domain="[('insurance_type','=','bhyt')]"/>
                <filter string="BHTN" name="bhtn" domain="[('insurance_type','=','bhtn')]"/>
                <separator/>
                <filter string="Bảo hiểm tự nguyện" name="voluntary" domain="[('is_voluntary','=',True)]"/>
                <filter string="Ốm đau" name="sickness" domain="[('insurance_coverage_type','=','sickness')]"/>
                <filter string="Thai sản" name="maternity" domain="[('insurance_coverage_type','=','maternity')]"/>
                <filter string="Tai nạn lao động" name="work_accident" domain="[('insurance_coverage_type','=','work_accident')]"/>
                <filter string="Bệnh nghề nghiệp" name="occupational_disease" domain="[('insurance_coverage_type','=','occupational_disease')]"/>
                <filter string="Hưu trí" name="retirement" domain="[('insurance_coverage_type','=','retirement')]"/>
                <filter string="Tử tuất" name="death" domain="[('insurance_coverage_type','=','death')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Loại bảo hiểm" name="groupby_type" context="{'group_by': 'insurance_type'}"/>
                    <filter string="Phạm vi bảo hiểm" name="groupby_coverage" context="{'group_by': 'insurance_coverage_type'}"/>
                    <filter string="Trạng thái" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Công ty" name="groupby_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for insurance with list,form,kanban views -->
    <record id="action_employee_insurance" model="ir.actions.act_window">
        <field name="name">Hợp đồng bảo hiểm</field>
        <field name="res_model">hr.insurance</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_id" ref="hr_insurance_tree_view"/>
        <field name="search_view_id" ref="hr_insurance_search_view"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo hợp đồng bảo hiểm mới
            </p>
            <p>
                Quản lý các hợp đồng bảo hiểm của nhân viên, bao gồm BHXH, BHYT, BHTN.
            </p>
        </field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_employee_insurance"
              name="Hợp đồng bảo hiểm"
              parent="menu_hr_insurance_root"
              action="action_employee_insurance"
              sequence="1"/>

</odoo>
