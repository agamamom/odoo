<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List view for policy -->
    <record id="view_insurance_policy_list" model="ir.ui.view">
        <field name="name">insurance.policy.list</field>
        <field name="model">insurance.policy</field>
        <field name="arch" type="xml">
            <list string="Chính sách bảo hiểm">
                <field name="name" width="220"/>
                <field name="policy_type" width="150"/>
                <field name="coverage_type" width="180"/>
                <field name="employee_rate" width="120"/>
                <field name="company_rate" width="120"/>
                <field name="total_rate" width="120"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    
    <!-- Form view for policy -->
    <record id="view_insurance_policy_form" model="ir.ui.view">
        <field name="name">insurance.policy.form</field>
        <field name="model">insurance.policy</field>
        <field name="arch" type="xml">
            <form string="Chính sách bảo hiểm">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên chính sách"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="policy_type"/>
                            <field name="coverage_type"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="employee_rate"/>
                            <field name="company_rate"/>
                            <field name="total_rate"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Search view for policy -->
    <record id="view_insurance_policy_search" model="ir.ui.view">
        <field name="name">insurance.policy.search</field>
        <field name="model">insurance.policy</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm chính sách bảo hiểm">
                <field name="name"/>
                <field name="policy_type"/>
                <field name="coverage_type"/>
                <separator/>
                <filter string="Bắt buộc" name="mandatory" domain="[('policy_type', '=', 'mandatory')]"/>
                <filter string="Tự nguyện" name="voluntary" domain="[('policy_type', '=', 'voluntary')]"/>
                <filter string="Đang kích hoạt" name="active" domain="[('active', '=', True)]"/>
                <filter string="Đã lưu trữ" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Loại chính sách" name="group_policy_type" context="{'group_by': 'policy_type'}"/>
                    <filter string="Loại phạm vi" name="group_coverage_type" context="{'group_by': 'coverage_type'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action for policy -->
    <record id="action_insurance_policy" model="ir.actions.act_window">
        <field name="name">Chính sách bảo hiểm</field>
        <field name="res_model">insurance.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu items -->
    <menuitem id="menu_insurance_policy"
              name="Chính sách bảo hiểm"
              parent="menu_hr_insurance_root"
              action="action_insurance_policy"
              sequence="3"/>
</odoo>
