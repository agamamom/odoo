<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_insurance_code_wizard" model="ir.ui.view">
        <field name="name">social.insurance.code.wizard.form</field>
        <field name="model">social.insurance.code.wizard</field>
        <field name="arch" type="xml">
            <form string="Cập nhật mã số BHXH">
                <sheet>
                    <group>
                        <field name="employee_id" readonly="context.get('default_employee_id')"/>
                        <field name="social_insurance_code"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_update_code" string="Cập nhật" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_social_insurance_code_wizard" model="ir.actions.act_window">
        <field name="name">Cập nhật mã số BHXH</field>
        <field name="res_model">social.insurance.code.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo> 