<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for hr.insurance policy -->
        <record id="seq_hr_insurance" model="ir.sequence">
            <field name="name">HR Insurance</field>
            <field name="code">hr.insurance</field>
            <field name="prefix">INS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for insurance.allowance -->
        <record id="seq_insurance_allowance" model="ir.sequence">
            <field name="name">Insurance Allowance</field>
            <field name="code">insurance.allowance</field>
            <field name="prefix">ALW/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for insurance.policy -->
        <record id="seq_insurance_policy" model="ir.sequence">
            <field name="name">Insurance Policy</field>
            <field name="code">insurance.policy</field>
            <field name="prefix">PL</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for insurance.payment -->
        <record id="seq_insurance_payment" model="ir.sequence">
            <field name="name">Insurance Payment</field>
            <field name="code">insurance.payment</field>
            <field name="prefix">PM</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for social.insurance.document -->
        <record id="seq_social_insurance_document" model="ir.sequence">
            <field name="name">Social Insurance Document</field>
            <field name="code">social.insurance.document</field>
            <field name="prefix">BHXH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for social.insurance.history -->
        <record id="seq_social_insurance_history" model="ir.sequence">
            <field name="name">Social Insurance History</field>
            <field name="code">social.insurance.history</field>
            <field name="prefix">SIH</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for social.insurance.benefit -->
        <record id="seq_social_insurance_benefit" model="ir.sequence">
            <field name="name">Social Insurance Benefit</field>
            <field name="code">social.insurance.benefit</field>
            <field name="prefix">SIB</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for social.insurance.late.fee -->
        <record id="seq_social_insurance_late_fee" model="ir.sequence">
            <field name="name">Social Insurance Late Fee</field>
            <field name="code">social.insurance.late.fee</field>
            <field name="prefix">LF</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Sequence for Document Template -->
        <record id="seq_insurance_document_template" model="ir.sequence">
            <field name="name">Insurance Document Template</field>
            <field name="code">insurance.document.template</field>
            <field name="prefix">TPL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo> 