<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View for Insurance Payment -->
    <record id="view_insurance_payment_form" model="ir.ui.view">
        <field name="name">insurance.payment.form</field>
        <field name="model">insurance.payment</field>
        <field name="arch" type="xml">
            <form string="Thanh toán bảo hiểm">
                <header>
                    <button name="action_confirm" type="object" string="Xác nhận" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_set_to_paid" type="object" string="Đánh dấu đã thanh toán" 
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_verify" type="object" string="Xác thực" 
                            class="oe_highlight" invisible="state != 'paid'"/>
                    <button name="action_reset_to_draft" type="object" string="Chuyển về dự thảo" 
                            invisible="state not in ('confirmed', 'paid', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Hủy" 
                            invisible="state not in ('draft', 'confirmed', 'paid')"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,paid,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_add_employees" type="object" 
                                class="oe_stat_button" icon="fa-users"
                                invisible="state not in ('draft', 'confirmed')">
                            <field name="employee_count" string="Nhân viên" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="payment_date"/>
                            <field name="period_month"/>
                            <field name="period_year"/>
                            <field name="insurance_type"/>
                        </group>
                        <group>
                            <field name="payment_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="payment_method"/>
                            <field name="payment_ref"/>
                            <field name="payment_authority"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết thanh toán" name="payment_details">
                            <field name="payment_line_ids">
                                <list string="Chi tiết thanh toán">
                                    <field name="employee_id" width="220"/>
                                    <field name="social_insurance_code" width="150"/>
                                    <field name="department_id" width="200"/>
                                    <field name="salary_base" sum="Tổng lương đóng BH" widget="monetary" options="{'currency_field': 'currency_id'}" width="180"/>
                                    <field name="bhxh_amount" sum="Tổng BHXH" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                                    <field name="bhyt_amount" sum="Tổng BHYT" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                                    <field name="bhtn_amount" sum="Tổng BHTN" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                                    <field name="total_amount" sum="Tổng đóng" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="bhxh_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="bhyt_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="bhtn_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="expected_amount"/>
                                </div>
                                <field name="expected_amount" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                <field name="difference_amount" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_subtotal_footer_separator"
                                       invisible="state == 'draft'"/>
                            </group>
                        </page>
                        <page string="Biên lai" name="receipt" invisible="state in ('draft', 'confirmed')">
                            <group>
                                <field name="receipt_filename" invisible="1"/>
                                <field name="receipt_attachment" filename="receipt_filename" widget="binary"/>
                            </group>
                        </page>
                        <page string="Ghi chú" name="notes">
                            <field name="notes" placeholder="Ghi chú về thanh toán..."/>
                        </page>
                    </notebook>
                    <group>
                        <group>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View for Insurance Payment -->
    <record id="view_insurance_payment_tree" model="ir.ui.view">
        <field name="name">insurance.payment.tree</field>
        <field name="model">insurance.payment</field>
        <field name="arch" type="xml">
            <list string="Thanh toán bảo hiểm">
                <field name="name" width="100"/>
                <field name="payment_date" width="100"/>
                <field name="period_month" width="80"/>
                <field name="period_year" width="80"/>
                <field name="insurance_type" width="150"/>
                <field name="payment_amount" sum="Tổng thanh toán" widget="monetary" options="{'currency_field': 'currency_id'}" width="180"/>
                <field name="expected_amount" sum="Tổng dự kiến" widget="monetary" options="{'currency_field': 'currency_id'}" width="180"/>
                <field name="payment_ref" width="180"/>
                <field name="employee_count" width="100"/>
                <field name="state" widget="badge" decoration-success="state == 'verified'" decoration-info="state == 'paid'" decoration-warning="state == 'confirmed'" decoration-danger="state == 'cancelled'" width="120"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Kanban View for Insurance Payment -->
    <record id="view_insurance_payment_kanban" model="ir.ui.view">
        <field name="name">insurance.payment.kanban</field>
        <field name="model">insurance.payment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <field name="insurance_type"/>
                <field name="payment_amount"/>
                <field name="employee_count"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <span>Kỳ: <field name="period_month"/>/<field name="period_year"/></span>
                                </div>
                                <div>
                                    <span>Ngày thanh toán: <field name="payment_date"/></span>
                                </div>
                                <div>
                                    <span>Số tiền: <field name="payment_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/></span>
                                </div>
                                <div>
                                    <span>Nhân viên: <field name="employee_count"/></span>
                                </div>
                                <div>
                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'confirmed': 'warning', 'paid': 'info', 'verified': 'success', 'cancelled': 'danger'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View for Insurance Payment -->
    <record id="view_insurance_payment_search" model="ir.ui.view">
        <field name="name">insurance.payment.search</field>
        <field name="model">insurance.payment</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm thanh toán bảo hiểm">
                <field name="name"/>
                <field name="payment_ref"/>
                <field name="payment_authority"/>
                <filter string="Dự thảo" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Đã xác nhận" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Đã thanh toán" name="paid" domain="[('state','=','paid')]"/>
                <filter string="Đã xác thực" name="verified" domain="[('state','=','verified')]"/>
                <filter string="Đã hủy" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Tháng này" name="this_month" domain="[('payment_date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),('payment_date','&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Quý này" name="this_quarter" domain="[('payment_date','&gt;=', (context_today() + relativedelta(month=3*(((context_today().month-1)//3)+1), day=1)).strftime('%Y-%m-%d')),('payment_date','&lt;', (context_today() + relativedelta(month=3*((context_today().month//3)+1), day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Năm nay" name="this_year" domain="[('payment_date','&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),('payment_date','&lt;=', (context_today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="BHXH" name="bhxh" domain="[('insurance_type','=','bhxh')]"/>
                <filter string="BHYT" name="bhyt" domain="[('insurance_type','=','bhyt')]"/>
                <filter string="BHTN" name="bhtn" domain="[('insurance_type','=','bhtn')]"/>
                <filter string="Tổng hợp" name="combined" domain="[('insurance_type','=','combined')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Loại bảo hiểm" name="groupby_type" context="{'group_by': 'insurance_type'}"/>
                    <filter string="Năm" name="groupby_year" context="{'group_by': 'period_year'}"/>
                    <filter string="Tháng" name="groupby_month" context="{'group_by': 'period_month'}"/>
                    <filter string="Công ty" name="groupby_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar View for Insurance Payment -->
    <record id="view_insurance_payment_calendar" model="ir.ui.view">
        <field name="name">insurance.payment.calendar</field>
        <field name="model">insurance.payment</field>
        <field name="arch" type="xml">
            <calendar string="Lịch thanh toán bảo hiểm" mode="month" color="insurance_type" date_start="payment_date">
                <field name="name"/>
                <field name="payment_amount" widget="monetary"/>
                <field name="insurance_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Action for Insurance Payment -->
    <record id="action_insurance_payment" model="ir.actions.act_window">
        <field name="name">Thanh toán bảo hiểm</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">insurance.payment</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo thanh toán bảo hiểm mới
            </p>
            <p>
                Quản lý các khoản thanh toán bảo hiểm xã hội cho nhân viên, bao gồm BHXH, BHYT, BHTN.
            </p>
        </field>
    </record>

    <!-- Form View for Insurance Payment Line -->
    <record id="view_insurance_payment_line_form" model="ir.ui.view">
        <field name="name">insurance.payment.line.form</field>
        <field name="model">insurance.payment.line</field>
        <field name="arch" type="xml">
            <form string="Chi tiết thanh toán bảo hiểm">
                <sheet>
                    <group>
                        <group>
                            <field name="payment_id"/>
                            <field name="employee_id"/>
                            <field name="social_insurance_code"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="salary_base" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="bhxh_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="bhyt_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="bhtn_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>
                    <group string="Tỷ lệ bảo hiểm">
                        <group string="Bảo hiểm xã hội (BHXH)">
                            <field name="employee_bhxh_rate"/>
                            <field name="employer_bhxh_rate"/>
                        </group>
                        <group string="Bảo hiểm y tế (BHYT)">
                            <field name="employee_bhyt_rate"/>
                            <field name="employer_bhyt_rate"/>
                        </group>
                        <group string="Bảo hiểm thất nghiệp (BHTN)">
                            <field name="employee_bhtn_rate"/>
                            <field name="employer_bhtn_rate"/>
                        </group>
                    </group>
                    <group string="Ghi chú">
                        <field name="notes" nolabel="1" placeholder="Ghi chú về khoản đóng bảo hiểm của nhân viên..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View for Insurance Payment Line -->
    <record id="view_insurance_payment_line_tree" model="ir.ui.view">
        <field name="name">insurance.payment.line.tree</field>
        <field name="model">insurance.payment.line</field>
        <field name="arch" type="xml">
            <list string="Chi tiết thanh toán bảo hiểm">
                <field name="payment_id" width="180"/>
                <field name="employee_id" width="220"/>
                <field name="social_insurance_code" width="150"/>
                <field name="department_id" width="180"/>
                <field name="salary_base" sum="Tổng" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                <field name="bhxh_amount" sum="Tổng BHXH" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                <field name="bhyt_amount" sum="Tổng BHYT" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                <field name="bhtn_amount" sum="Tổng BHTN" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                <field name="total_amount" sum="Tổng đóng" widget="monetary" options="{'currency_field': 'currency_id'}" width="150"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View for Insurance Payment Difference Wizard -->
    <record id="view_insurance_payment_difference_wizard_form" model="ir.ui.view">
        <field name="name">insurance.payment.difference.wizard.form</field>
        <field name="model">insurance.payment.difference.wizard</field>
        <field name="arch" type="xml">
            <form string="Xử lý chênh lệch thanh toán">
                <sheet>
                    <group>
                        <div class="alert alert-warning" role="alert">
                            <p>Số tiền thanh toán chênh lệch nhiều so với số tiền dự kiến. Vui lòng giải thích lý do.</p>
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="payment_id" invisible="1"/>
                            <field name="difference_amount" widget="monetary"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <group string="Giải thích chi tiết">
                        <field name="notes" nolabel="1" placeholder="Vui lòng giải thích lý do chênh lệch..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Xác nhận" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Form View for Insurance Payment Employee Wizard -->
    <record id="view_insurance_payment_employee_wizard_form" model="ir.ui.view">
        <field name="name">insurance.payment.employee.wizard.form</field>
        <field name="model">insurance.payment.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Thêm nhân viên vào thanh toán">
                <sheet>
                    <group>
                        <group>
                            <field name="payment_id" invisible="1"/>
                            <field name="department_id"/>
                            <field name="include_with_insurance_only"/>
                        </group>
                    </group>
                    <group string="Chọn nhân viên">
                        <field name="employee_ids" nolabel="1" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_add_employees" type="object" string="Thêm nhân viên" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Payment history now available in the standard report -->

    <!-- Menu Items -->
    <menuitem id="menu_insurance_payment"
              name="Insurance Payments"
              parent="hr_insurance_menu"
              action="action_insurance_payment"
              sequence="60"/>
</odoo> 