<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Clean Document View Form -->
    <record id="view_clean_document_form" model="ir.ui.view">
        <field name="name">hr.insurance.clean.document.form</field>
        <field name="model">social.insurance.document</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Tài liệu BHXH" create="true">
                <header>
                    <button name="action_submit" string="Nộp tài liệu" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Duyệt" type="object" 
                            class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Từ chối" type="object" 
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_cancel" string="Hủy" type="object" 
                            invisible="state in ('approved', 'rejected', 'cancelled')"/>
                    <button name="action_draft" string="Chuyển về dự thảo" type="object" 
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <button name="action_generate_form" string="Tạo biểu mẫu" type="object" 
                            class="btn-primary" 
                            invisible="document_type not in ('registration', 'adjustment', 'termination', 'unemployment', 'tk1_ts', 'tk3_ts')"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_generate_form" 
                                string="Tạo biểu mẫu" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text-o"
                                invisible="document_type not in ('registration', 'adjustment', 'termination', 'unemployment', 'tk1_ts', 'tk3_ts')"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="insurance_id"/>
                            <field name="document_type"/>
                            <field name="adjustment_type" invisible="document_type != 'adjustment'"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="deadline"/>
                            <field name="submit_date" readonly="state in ('submitted', 'approved')"/>
                            <field name="approval_date" readonly="state == 'approved'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thông tin chung" name="general_info">
                            <group>
                                <group>
                                    <field name="reference"/>
                                    <field name="officer_id"/>
                                </group>
                                <group>
                                    <field name="agency_officer"/>
                                    <field name="agency_response"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Thẻ BHYT" name="bhyt_card" invisible="document_type != 'bhyt_card'">
                            <group>
                                <group>
                                    <field name="bhyt_number"/>
                                    <field name="bhyt_issue_date"/>
                                    <field name="bhyt_expiry_date"/>
                                </group>
                                <group>
                                    <field name="bhyt_hospital"/>
                                    <field name="is_bhyt_expired"/>
                                    <field name="days_to_expire"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Sổ BHXH" name="bhxh_book" invisible="document_type != 'bhxh_book'">
                            <group>
                                <group>
                                    <field name="bhxh_book_number"/>
                                    <field name="bhxh_book_issue_date"/>
                                </group>
                                <group>
                                    <field name="bhxh_book_issue_place"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Ghi chú" name="notes">
                            <field name="notes" placeholder="Ghi chú về tài liệu..."/>
                        </page>
                        
                        <page string="Tài liệu đính kèm" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- New action for clean document view -->
    <record id="action_clean_insurance_document" model="ir.actions.act_window">
        <field name="name">Tài liệu BHXH mới</field>
        <field name="res_model">social.insurance.document</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_clean_document_form"/>
        <field name="target">current</field>
    </record>

    <!-- Menu for clean document view -->
    <menuitem id="menu_clean_insurance_document"
              name="Tạo mới tài liệu BHXH" 
              parent="menu_hr_insurance_root" 
              action="action_clean_insurance_document" 
              sequence="6"/>
</odoo> 