<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List view for Social Insurance Benefits -->
    <record id="view_social_insurance_benefit_list" model="ir.ui.view">
        <field name="name">social.insurance.benefit.list</field>
        <field name="model">social.insurance.benefit</field>
        <field name="arch" type="xml">
            <list string="Quyền lợi hưởng chế độ BHXH">
                <field name="name" width="100"/>
                <field name="employee_id" width="220"/>
                <field name="benefit_type" width="180"/>
                <field name="date_from" width="100"/>
                <field name="date_to" width="100"/>
                <field name="benefit_days" width="100"/>
                <field name="salary_base" sum="Tổng" width="150"/>
                <field name="benefit_rate" width="100"/>
                <field name="benefit_amount" sum="Tổng trợ cấp" width="150"/>
                <field name="state" decoration-info="state == 'draft'" 
                       decoration-warning="state == 'submitted'" 
                       decoration-success="state == 'approved'" 
                       decoration-danger="state == 'rejected'"
                       width="120"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form view for Social Insurance Benefits -->
    <record id="view_social_insurance_benefit_form" model="ir.ui.view">
        <field name="name">social.insurance.benefit.form</field>
        <field name="model">social.insurance.benefit</field>
        <field name="arch" type="xml">
            <form string="Hưởng chế độ BHXH">
                <header>
                    <button name="action_submit" string="Gửi yêu cầu" type="object" 
                           class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Phê duyệt" type="object" 
                           class="oe_highlight" invisible="state != 'submitted'" 
                           groups="hr.group_hr_manager"/>
                    <button name="action_reject" string="Từ chối" type="object" 
                           invisible="state not in ('submitted', 'approved')" 
                           groups="hr.group_hr_manager"/>
                    <button name="action_reset_to_draft" string="Chuyển về dự thảo" type="object" 
                           invisible="state == 'draft'"/>
                    <button name="action_mark_as_paid" string="Đánh dấu đã chi trả" type="object" 
                           class="oe_highlight" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,submitted,approved,paid,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="benefit_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="benefit_days"/>
                            <field name="salary_base"/>
                        </group>
                        <group>
                            <field name="benefit_rate" widget="percentage"/>
                            <field name="benefit_amount"/>
                            <field name="payment_method" invisible="state != 'paid'"/>
                            <field name="payment_date" invisible="state != 'paid'"/>
                            <field name="agency_reference"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thông tin chi tiết" name="details">
                            <group>
                                <field name="description" placeholder="Mô tả chi tiết về việc hưởng chế độ này..."/>
                                <field name="notes" placeholder="Ghi chú bổ sung..."/>
                            </group>
                        </page>
                        <page string="Điều kiện hưởng chế độ" name="conditions" invisible="benefit_type != 'maternity'">
                            <group>
                                <group string="Điều kiện hưởng chế độ thai sản">
                                    <field name="is_birth_benefit"/>
                                    <field name="has_participated_enough" invisible="not is_birth_benefit"/>
                                    <field name="birth_certificate_number" invisible="not is_birth_benefit"/>
                                    <field name="birth_certificate_date" invisible="not is_birth_benefit"/>
                                    <field name="labor_book_number"/>
                                    <field name="labor_book_date"/>
                                </group>
                                <group string="Thông tin trẻ" invisible="not is_birth_benefit">
                                    <field name="child_name"/>
                                    <field name="child_birth_date"/>
                                    <field name="child_gender"/>
                                    <field name="is_premature_birth"/>
                                    <field name="is_multiple_birth"/>
                                    <field name="multiple_birth_count" invisible="not is_multiple_birth"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tài liệu đính kèm" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view for Social Insurance Benefits -->
    <record id="view_social_insurance_benefit_search" model="ir.ui.view">
        <field name="name">social.insurance.benefit.search</field>
        <field name="model">social.insurance.benefit</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm chế độ BHXH">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="benefit_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                
                <!-- Filters -->
                <filter string="Dự thảo" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Đã gửi" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Đã phê duyệt" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Đã chi trả" name="paid" domain="[('state','=','paid')]"/>
                <filter string="Bị từ chối" name="rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="Ốm đau" name="om_dau" domain="[('benefit_type','=','sickness')]"/>
                <filter string="Thai sản" name="thai_san" domain="[('benefit_type','=','maternity')]"/>
                <filter string="Tai nạn lao động" name="tnld" domain="[('benefit_type','=','work_accident')]"/>
                <filter string="Dưỡng sức" name="duong_suc" domain="[('benefit_type','=','rehabilitation')]"/>
                <separator/>
                <filter string="Trong tháng này" name="this_month" 
                        domain="[('date_from','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                ('date_from','&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                
                <!-- Groups -->
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Loại chế độ" name="benefit_type" context="{'group_by': 'benefit_type'}"/>
                    <filter string="Trạng thái" name="state" context="{'group_by': 'state'}"/>
                    <filter string="Công ty" name="company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions and Menu Items -->
    <record id="action_social_insurance_benefit" model="ir.actions.act_window">
        <field name="name">Chế độ BHXH</field>
        <field name="res_model">social.insurance.benefit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo yêu cầu hưởng chế độ BHXH mới
            </p>
            <p>
                Quản lý các chế độ hưởng BHXH như ốm đau, thai sản, 
                tai nạn lao động, và dưỡng sức phục hồi sức khỏe.
            </p>
        </field>
    </record>
    
    <menuitem id="menu_social_insurance_benefit"
              name="Chế độ BHXH"
              parent="menu_hr_insurance_root"
              action="action_social_insurance_benefit"
              sequence="20"/>
</odoo> 