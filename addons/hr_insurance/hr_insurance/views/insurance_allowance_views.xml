<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form view for Insurance Allowance -->
    <record id="view_insurance_allowance_form" model="ir.ui.view">
        <field name="name">insurance.allowance.form</field>
        <field name="model">insurance.allowance</field>
        <field name="arch" type="xml">
            <form string="Trợ cấp bảo hiểm">
                <field name="related_document_model" invisible="1" />
                <field name="related_document_id" invisible="1" />
                <field name="related_partner" invisible="1" />
                <header>
                    <button name="action_approve" type="object" string="Phê duyệt" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_pay" type="object" string="Đánh dấu đã trả" 
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_draft" type="object" string="Chuyển về dự thảo" 
                            invisible="state not in ('approved', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Hủy" 
                            invisible="state not in ('draft', 'approved')"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="insurance_id" options="{'no_create': True}"/>
                            <field name="allowance_type"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="payment_method"/>
                            <field name="reference"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ghi chú" name="notes">
                            <field name="notes" placeholder="Ghi chú về khoản trợ cấp..."/>
                        </page>
                        <page string="Tài liệu" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter" invisible="1">
                    <field name="message_follower_ids" widget="mail_followers" invisible="1"/>
                    <field name="message_ids" widget="mail_thread" invisible="1"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List view for Insurance Allowance -->
    <record id="view_insurance_allowance_list" model="ir.ui.view">
        <field name="name">insurance.allowance.list</field>
        <field name="model">insurance.allowance</field>
        <field name="arch" type="xml">
            <list string="Trợ cấp bảo hiểm">
                <field name="name"/>
                <field name="insurance_id"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="allowance_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Search view for Insurance Allowance -->
    <record id="view_insurance_allowance_search" model="ir.ui.view">
        <field name="name">insurance.allowance.search</field>
        <field name="model">insurance.allowance</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm trợ cấp bảo hiểm">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="allowance_type"/>
                <field name="reference"/>
                <filter string="Dự thảo" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Đã phê duyệt" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Đã trả" name="paid" domain="[('state','=','paid')]"/>
                <filter string="Đã hủy" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter string="Tháng này" name="this_month" domain="[('date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),('date','&lt;=', (context_today() + relativedelta(months=1, day=1, days=-1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Quý này" name="this_quarter" domain="[('date','&gt;=', (context_today() + relativedelta(month=3*(((context_today().month-1)//3)+1), day=1)).strftime('%Y-%m-%d')),('date','&lt;', (context_today() + relativedelta(month=3*((context_today().month//3)+1), day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Năm nay" name="this_year" domain="[('date','&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),('date','&lt;=', (context_today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Ốm đau" name="sickness" domain="[('allowance_type','=','sickness')]"/>
                <filter string="Thai sản" name="maternity" domain="[('allowance_type','=','maternity')]"/>
                <filter string="Tai nạn lao động" name="work_accident" domain="[('allowance_type','=','work_accident')]"/>
                <filter string="Bệnh nghề nghiệp" name="occupational_disease" domain="[('allowance_type','=','occupational_disease')]"/>
                <filter string="Thất nghiệp" name="unemployment" domain="[('allowance_type','=','unemployment')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Loại trợ cấp" name="groupby_type" context="{'group_by': 'allowance_type'}"/>
                    <filter string="Trạng thái" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Tháng" name="groupby_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Công ty" name="groupby_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Insurance Allowance -->
    <record id="action_insurance_allowance" model="ir.actions.act_window">
        <field name="name">Trợ cấp bảo hiểm</field>
        <field name="res_model">insurance.allowance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_insurance_allowance_list"/>
        <field name="search_view_id" ref="view_insurance_allowance_search"/>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo trợ cấp bảo hiểm mới
            </p>
            <p>
                Quản lý các khoản trợ cấp bảo hiểm cho nhân viên.
            </p>
        </field>
    </record>

    <!-- Menu for Allowance -->
    <menuitem id="menu_insurance_allowance"
              name="Trợ cấp"
              parent="menu_hr_insurance_root"
              action="action_insurance_allowance"
              sequence="2"/>


</odoo> 