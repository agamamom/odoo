<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List view for Social Insurance History -->
    <record id="view_social_insurance_history_list" model="ir.ui.view">
        <field name="name">social.insurance.history.list</field>
        <field name="model">social.insurance.history</field>
        <field name="arch" type="xml">
            <list string="Lịch sử đóng BHXH">
                <field name="name" width="100"/>
                <field name="employee_id" width="220"/>
                <field name="year" width="80"/>
                <field name="month" width="80"/>
                <field name="salary_base" sum="Tổng" width="150"/>
                <field name="total_employee_amount" sum="Tổng NV" width="150"/>
                <field name="total_company_amount" sum="Tổng CT" width="150"/>
                <field name="total_amount" sum="Tổng cộng" width="150"/>
                <field name="state" decoration-info="state == 'draft'" 
                       decoration-success="state == 'paid'" 
                       decoration-warning="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"
                       width="120"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form view for Social Insurance History -->
    <record id="view_social_insurance_history_form" model="ir.ui.view">
        <field name="name">social.insurance.history.form</field>
        <field name="model">social.insurance.history</field>
        <field name="arch" type="xml">
            <form string="Lịch sử đóng BHXH">
                <header>
                    <button name="action_confirm" string="Xác nhận" type="object" 
                           class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mark_as_paid" string="Đánh dấu đã đóng" type="object" 
                           class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Hủy" type="object" 
                           invisible="state in ('cancelled')"/>
                    <button name="action_reset_to_draft" string="Chuyển về dự thảo" type="object" 
                           invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="insurance_id"/>
                            <field name="year"/>
                            <field name="month"/>
                            <field name="salary_base"/>
                        </group>
                        <group>
                            <field name="payment_date" readonly="state == 'paid'"/>
                            <field name="payment_method" readonly="state == 'paid'"/>
                            <field name="payment_reference" readonly="state == 'paid'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết BHXH" name="bhxh_details">
                            <group>
                                <group string="BHXH">
                                    <field name="bhxh_employee_amount"/>
                                    <field name="bhxh_company_amount"/>
                                    <field name="bhxh_total_amount"/>
                                </group>
                                <group string="BHYT">
                                    <field name="bhyt_employee_amount"/>
                                    <field name="bhyt_company_amount"/>
                                    <field name="bhyt_total_amount"/>
                                </group>
                                <group string="BHTN">
                                    <field name="bhtn_employee_amount"/>
                                    <field name="bhtn_company_amount"/>
                                    <field name="bhtn_total_amount"/>
                                </group>
                                <group string="Tổng cộng">
                                    <field name="total_employee_amount"/>
                                    <field name="total_company_amount"/>
                                    <field name="total_amount"/>
                                </group>
                            </group>
                        </page>
                        <page string="Ghi chú" name="notes">
                            <field name="notes" placeholder="Ghi chú về việc đóng BHXH..."/>
                        </page>
                        <page string="Tài liệu đính kèm" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search view for Social Insurance History -->
    <record id="view_social_insurance_history_search" model="ir.ui.view">
        <field name="name">social.insurance.history.search</field>
        <field name="model">social.insurance.history</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm lịch sử đóng BHXH">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="year"/>
                <field name="month"/>
                
                <!-- Filters -->
                <filter string="Dự thảo" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Đã xác nhận" name="filter_confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Đã đóng" name="filter_paid" domain="[('state','=','paid')]"/>
                <filter string="Đã hủy" name="filter_cancelled" domain="[('state','=','cancelled')]"/>
                
                <!-- Groups -->
                <group expand="0" string="Nhóm theo">
                    <filter string="Nhân viên" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Năm" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Tháng" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Công ty" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action for Social Insurance History -->
    <record id="action_social_insurance_history" model="ir.actions.act_window">
        <field name="name">Lịch sử đóng BHXH</field>
        <field name="res_model">social.insurance.history</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo bản ghi lịch sử đóng BHXH mới
            </p>
            <p>
                Quản lý theo dõi lịch sử đóng BHXH, BHYT, BHTN của nhân viên hàng tháng.
            </p>
        </field>
    </record>
    
    <!-- Menu item for Social Insurance History -->
    <menuitem id="menu_social_insurance_history"
              name="Lịch sử đóng BHXH" 
              parent="menu_hr_insurance_root" 
              action="action_social_insurance_history" 
              sequence="10"/>
</odoo> 