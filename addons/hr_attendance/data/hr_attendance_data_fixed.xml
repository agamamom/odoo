<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_attendance_check_out_cron" model="ir.cron">
            <field name="name">Attendance: Automatically check-out employees</field>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[model._cron_auto_check_out()]]></field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="hr_attendance_absence_cron" model="ir.cron">
            <field name="name">Attendance: Detect Absences for employees</field>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[model._cron_absence_detection()]]></field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="cron_check_missed_attendance" model="ir.cron">
            <field name="name">Check Missed Attendance</field>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[model._check_missed_attendance()]]></field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_overtime_approval_reminder" model="ir.cron">
            <field name="name">Overtime Approval Reminder</field>
            <field name="model_id" ref="model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[model._send_overtime_approval_reminder()]]></field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo> 