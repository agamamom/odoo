<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="hr_payroll_data_protection_view_form" model="ir.ui.view">
        <field name="name">hr.payroll.data.protection.form</field>
        <field name="model">hr.payroll.data.protection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Company Data Protection"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                            <field name="data_officer_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="enable_data_subject_requests"/>
                            <field name="data_retention_period"/>
                            <field name="auto_anonymize"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" style="margin-top: 15px;">
                        <p><strong>Note:</strong> These settings affect how employee data is handled according to GDPR requirements.</p>
                        <ul>
                            <li>Data Protection Officer will be notified of all GDPR requests.</li>
                            <li>Data retention period determines how long personal data is kept before anonymization.</li>
                            <li>When data subject requests are enabled, employees can submit access, correction, and deletion requests.</li>
                        </ul>
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View (previously Tree View) -->
    <record id="hr_payroll_data_protection_view_list" model="ir.ui.view">
        <field name="name">hr.payroll.data.protection.list</field>
        <field name="model">hr.payroll.data.protection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="data_officer_id"/>
                <field name="enable_data_subject_requests"/>
                <field name="data_retention_period"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="hr_payroll_data_protection_view_search" model="ir.ui.view">
        <field name="name">hr.payroll.data.protection.search</field>
        <field name="model">hr.payroll.data.protection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="data_officer_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Data Officer" name="group_officer" context="{'group_by': 'data_officer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hr_payroll_data_protection_action" model="ir.actions.act_window">
        <field name="name">Data Protection Settings</field>
        <field name="res_model">hr.payroll.data.protection</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_payroll_data_protection_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data protection settings found
            </p>
            <p>
                Create data protection settings to enable GDPR compliance features.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hr_data_protection" name="Data Protection Settings"
              parent="menu_hr_gdpr_root" action="hr_payroll_data_protection_action"
              sequence="20"/>
</odoo> 