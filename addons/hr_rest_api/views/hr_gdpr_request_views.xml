<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="hr_gdpr_request_view_form" model="ir.ui.view">
        <field name="name">hr.gdpr.request.form</field>
        <field name="model">hr.gdpr.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign_to_me" string="Assign to Me" type="object" 
                            invisible="state != 'pending' or assigned_to_id"
                            groups="hr.group_hr_user"/>
                    <button name="action_complete" string="Mark as Completed" type="object" 
                            invisible="state != 'in_progress'"
                            groups="hr.group_hr_user"/>
                    <button name="action_reject" string="Reject" type="object" 
                            invisible="state not in ('pending', 'in_progress')"
                            groups="hr.group_hr_user"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="pending,in_progress,completed,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="request_type"/>
                            <field name="request_date"/>
                            <field name="completion_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="assigned_to_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="data_officer_id" readonly="1"/>
                            <field name="protection_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Details" name="details">
                            <group invisible="request_type != 'correction'">
                                <field name="field_to_correct" required="request_type == 'correction'"/>
                                <field name="current_value"/>
                                <field name="requested_value" required="request_type == 'correction'"/>
                            </group>
                            <group>
                                <field name="note" placeholder="Add any additional notes or context for this request..."/>
                            </group>
                            <group invisible="not rejection_reason">
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                        </page>
                        <page string="Response" name="response" invisible="state not in ('completed', 'rejected')">
                            <group>
                                <field name="response_file" filename="response_filename"/>
                                <field name="response_filename" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View (previously Tree View) -->
    <record id="hr_gdpr_request_view_list" model="ir.ui.view">
        <field name="name">hr.gdpr.request.list</field>
        <field name="model">hr.gdpr.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'" decoration-muted="state == 'rejected'" decoration-success="state == 'completed'" decoration-warning="state == 'in_progress'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_type"/>
                <field name="request_date"/>
                <field name="assigned_to_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="hr_gdpr_request_view_search" model="ir.ui.view">
        <field name="name">hr.gdpr.request.search</field>
        <field name="model">hr.gdpr.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="request_type"/>
                <separator/>
                <filter string="My Assigned Requests" name="my_requests" domain="[('assigned_to_id', '=', uid)]"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Request Type" name="group_type" context="{'group_by': 'request_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_to_id'}"/>
                    <filter string="Request Date" name="group_request_date" context="{'group_by': 'request_date'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="hr_gdpr_request_action" model="ir.actions.act_window">
        <field name="name">GDPR Requests</field>
        <field name="res_model">hr.gdpr.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_gdpr_request_view_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No GDPR requests found
            </p>
            <p>
                GDPR requests will be shown here when employees submit them through the Employee Self-Service portal.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hr_gdpr_root" name="GDPR Compliance"
              parent="hr.menu_hr_root" sequence="99"
              groups="hr.group_hr_user"/>

    <menuitem id="menu_hr_gdpr_request" name="Data Requests"
              parent="menu_hr_gdpr_root" action="hr_gdpr_request_action"
              sequence="10"/>

    <!-- Reject Wizard Form -->
    <record id="hr_gdpr_request_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.gdpr.request.reject.wizard.form</field>
        <field name="model">hr.gdpr.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="rejection_reason" placeholder="Please provide a reason for rejecting this request..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo> 