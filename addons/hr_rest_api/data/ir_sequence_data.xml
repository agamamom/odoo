<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for GDPR Requests -->
        <record id="seq_hr_gdpr_request" model="ir.sequence">
            <field name="name">GDPR Request</field>
            <field name="code">hr.gdpr.request</field>
            <field name="prefix">GDPR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo> 