<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Company Form View -->
    <record id="view_company_form_inherit_geolocation" model="ir.ui.view">
        <field name="name">res.company.form.inherit.geolocation</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <!-- Ẩn các trường địa chỉ gốc thay vì replace chúng -->
            <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//field[@name='street2']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Thêm các trường địa chỉ riêng biệt sau trường street2 gốc -->
            <xpath expr="//field[@name='street2']" position="after">
                <div class="o_address_format">
                    <!-- Địa chỉ đường phố -->
                    <field name="street" placeholder="Street..." class="o_address_street"/>
                    
                    <!-- Row 1: City và Country -->
                    <div class="row mt-2">
                        <div class="col-6">
                            <field name="city" placeholder="City" class="o_address_city"/>
                        </div>
                        <div class="col-6">
                            <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                        </div>
                    </div>
                    
                    <!-- Row 2: State -->
                    <div class="row mt-2">
                        <div class="col-12">
                            <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                        </div>
                    </div>
                    
                    <!-- Row 3: Bản đồ và tọa độ -->
                    <div class="geo_map_container mt-3">
                        <!-- Bản đồ - Ẩn input nhưng hiển thị map -->
                        <field name="location_address" widget="geolocation_map" placeholder="Click on map to update location" class="hide_input_show_map"/>
                        
                        <!-- Thông tin tọa độ -->
                        <div class="geo_coordinates_container mt-2">
                            <div class="row">
                                <div class="col-6">
                                    <label for="latitude" class="oe_inline font-weight-bold"/>
                                    <field name="latitude" class="oe_inline"/>
                                </div>
                                <div class="col-6">
                                    <label for="longitude" class="oe_inline font-weight-bold"/>
                                    <field name="longitude" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="text-muted small text-center mt-2">
                                <i class="fa fa-info-circle"></i> Click on the map to update coordinates
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Add a custom tree view for debugging -->
    <record id="view_company_tree_with_coordinates" model="ir.ui.view">
        <field name="name">res.company.tree.coordinates</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <!-- Loại bỏ latitude và longitude -->
                <field name="location_address"/>
            </field>
        </field>
    </record>
    
    <!-- Create a dedicated menu for testing - use existing action -->
    <menuitem id="menu_company_geolocation"
              name="Company Locations"
              parent="base.menu_administration"
              sequence="10"
              action="base.action_res_company_form"/>
</odoo> 