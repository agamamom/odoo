<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Form view of salary advance.-->
    <record id="salary_advance_view_form" model="ir.ui.view">
        <field name="name">salary.advance.view.form</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <form string="Tạm ứng lương">
                <header>
                    <button name="action_submit_to_manager" string="Gửi phê duyệt" type="object" class="oe_highlight"/>
                    <button name="approve_request" string="Duyệt cấp 1" type="object" class="oe_highlight" groups="hr.group_hr_manager,hr.group_hr_user"/>
                    <button name="approve_request_acc_dept" string="Duyệt cấp 2" type="object" class="oe_highlight" groups="account.group_account_manager,account.group_account_user"/>
                    <button name="action_cancel" string="Hủy" type="object"/>
                    <button name="action_reject" string="Từ chối" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,waiting_approval,approve,cancel,reject"/>
                </header>
                <sheet>
                    <div class="oe_title oe_left">
                        <h2>
                            <field name="name" class="oe_inline" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="date"/>
                            <field name="advance_type"/>
                            <field name="reason"/>
                            <field name="exceed_condition" groups="hr.group_hr_manager,hr.group_hr_user"/>
                        </group>
                        <group>
                            <field name="advance"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_currency"/>
                            <field name="credit_id" groups="account.group_account_manager"/>
                            <field name="debit_id" groups="account.group_account_manager"/>
                            <field name="journal_id" groups="account.group_account_manager"/>
                            <field name="employee_contract_id" groups="hr.group_hr_manager,hr.group_hr_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử phê duyệt">
                            <field name="approval_line_ids">
                                <list string="Lịch sử phê duyệt">
                                    <field name="level" string="Cấp"/>
                                    <field name="approver_id" string="Người phê duyệt"/>
                                    <field name="state" string="Trạng thái"/>
                                    <field name="note" string="Ghi chú"/>
                                    <field name="date" string="Ngày phê duyệt"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tệp đính kèm">
                            <field name="attachments" widget="many2many_binary"/>
                        </page>
                        <page string="Lý do từ chối">
                            <field name="reject_reason"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!--    List view of salary advance-->
    <record model="ir.ui.view" id="salary_advance_view_tree">
        <field name="name">salary.advance.view.list</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <list string="Tạm ứng lương">
                <field name="employee_id" string="Nhân viên"/>
                <field name="date" string="Ngày tạm ứng"/>
                <field name="advance" string="Số tiền tạm ứng"/>
                <field name="advance_type" string="Loại tạm ứng"/>
                <field name="state" string="Trạng thái"/>
                <field name="is_deducted" string="Đã trừ vào lương"/>
            </list>
        </field>
    </record>
    <!--  Search view of salary advance.-->
    <record id="salary_advance_view_search" model="ir.ui.view">
        <field name="name">salary.advance.view.search</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" string="Salary Advance"
                       filter_domain="['|',('name','ilike',self)]"/>
                <field name="employee_id"/>
                <field name="state"/>
                <filter string="My Requests"
                        domain="[('employee_id.user_id.id','=',uid)]"
                        name="my_requests_filter"/>
                <filter domain="[('state', '=', 'draft')]" string="To Submit"
                        name="to_report" help="New Requests"/>
                <filter domain="[('state','in',('submit','waiting_approval'))]"
                        string="To Approve" name="submitted"
                        help="Submitted Requests"/>
                <filter domain="[('state', '=', 'approve')]" string="Approved"
                        name="approved" help="Approved Requests"/>
                <separator/>
                <filter string="Employee" name="employee_id" domain="[]"
                        context="{'group_by':'employee_id'}"/>
                <filter name="State" string="State" domain="[]"
                        context="{'group_by':'state'}"/>
                <filter string="Date" domain="[]" name="date"
                        context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>
    <!--   Window action to view own all records.-->
    <record id="salary_advance_own_action" model="ir.actions.act_window">
        <field name="name">Tạm ứng lương</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">salary.advance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="salary_advance_view_search"/>
        <field name="context">{'search_default_my_requests_filter':1}</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Tạo yêu cầu tạm ứng.
            </p>
        </field>
    </record>
    <!--   Window action to view own request approved records.-->
    <record id="salary_advance_own_request_approved_action"
            model="ir.actions.act_window">
        <field name="name">Tạm ứng đã duyệt của tôi</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">salary.advance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="salary_advance_view_search"/>
        <field name="context">{'search_default_approved':1}</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Tạo yêu cầu tạm ứng.
            </p>
        </field>
    </record>
    <!--   Window action to view records to approve.-->
    <record id="salary_advance_to_approve_action" model="ir.actions.act_window">
        <field name="name">Tạm ứng chờ phê duyệt</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">salary.advance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="salary_advance_view_search"/>
        <field name="context">{'search_default_submitted': 1}</field>
        <field name="domain"></field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Tạo yêu cầu tạm ứng.
            </p>
        </field>
    </record>
    <!--  Menu items of salary advance.-->
    <menuitem id="salary_advance_menu_root"
              name="Tạm ứng"
              parent="hr.menu_hr_root"
              sequence="7"/>
    <menuitem id="salary_advance_menu_own" action="salary_advance_own_action"
              parent="salary_advance_menu_root" name="Yêu cầu tạm ứng lương"
              sequence="1"/>
    <menuitem id="salary_advance_menu_to_approve"
              action="salary_advance_to_approve_action"
              parent="salary_advance_menu_root"
              name="Tạm ứng chờ phê duyệt" sequence="3"
              groups="hr.group_hr_manager,hr.group_hr_user,account.group_account_manager"/>
    <menuitem id="salary_advance_menu_my_approved"
              action="salary_advance_own_request_approved_action"
              parent="salary_advance_menu_root"
              name="Tạm ứng đã duyệt của tôi" sequence="2"/>
    <record id="view_salary_advance_report_list" model="ir.ui.view">
        <field name="name">salary.advance.report.list</field>
        <field name="model">salary.advance.report</field>
        <field name="arch" type="xml">
            <list string="Báo cáo tổng hợp tạm ứng lương">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="month"/>
                <field name="total_advance"/>
                <field name="total_deducted"/>
                <field name="total_remaining"/>
            </list>
        </field>
    </record>
    <record id="action_salary_advance_report" model="ir.actions.act_window">
        <field name="name">Báo cáo tạm ứng lương</field>
        <field name="res_model">salary.advance.report</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_salary_advance_report_list"/>
    </record>
    <menuitem id="menu_salary_advance_report" name="Báo cáo tạm ứng lương" parent="salary_advance_menu_root" action="action_salary_advance_report" sequence="99"/>
</odoo>
