<odoo>
    <template id="report_salary_advance_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <h2 style="text-align:center">ĐƠN XIN TẠM ỨNG LƯƠNG</h2>
                    <p><strong>Mã tạm ứng:</strong> <span t-esc="o.name"/></p>
                    <p><strong>Nhân viên:</strong> <span t-esc="o.employee_id.name"/></p>
                    <p><strong>Phòng ban:</strong> <span t-esc="o.department_id.name"/></p>
                    <p><strong>Ngày tạm ứng:</strong> <span t-esc="o.date"/></p>
                    <p><strong>Số tiền tạm ứng:</strong> <span t-esc="o.advance"/> <span t-esc="o.currency_id.name"/></p>
                    <p><strong>Lý do:</strong> <span t-esc="o.reason"/></p>
                    <p><strong>Trạng thái:</strong> <span t-esc="o.state"/></p>
                    <h4>Lịch sử phê duyệt</h4>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Cấp</th>
                                <th>Người phê duyệt</th>
                                <th>Trạng thái</th>
                                <th>Ngày</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.approval_line_ids" t-as="line">
                                <td t-esc="line.level"/>
                                <td t-esc="line.approver_id.name"/>
                                <td t-esc="line.state"/>
                                <td t-esc="line.date"/>
                                <td t-esc="line.note"/>
                            </tr>
                        </tbody>
                    </table>
                    <br/>
                    <div style="margin-top:40px;">
                        <div style="float:left;width:33%;text-align:center;">Người làm đơn<br/><br/><br/>__________________</div>
                        <div style="float:left;width:33%;text-align:center;">Quản lý<br/><br/><br/>__________________</div>
                        <div style="float:left;width:33%;text-align:center;">Kế toán<br/><br/><br/>__________________</div>
                        <div style="clear:both;"></div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo> 